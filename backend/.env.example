# Copy to backend/.env (never commit .env). All settings: src/d2s/config.py

# Supabase > Project Settings > Database > Connection string > Session pooler (port 5432)
# D2S_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT signing secret (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# D2S_JWT_SECRET=
# D2S_JWT_TTL_MINUTES=720
# D2S_AUTH_REQUIRED=true
